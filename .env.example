# ============================================
# JCoQL+ NL Interface - Environment Variables
# ============================================

# --- GOOGLE GEMINI API ---
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# --- LLM CONFIGURATION ---
# Active LLM: gemini | llama | gemma
# 
# gemini: Cloud, 500 RPD (Gemini 3.1 Flash Lite)
# llama:  Locale, ∞ quota (Llama 3.1 8B - 4.7GB VRAM)
# gemma:  Locale, ∞ quota (Gemma 2 9B - 5.4GB VRAM)
#
# ⚠️ NOTA VRAM: Gemma richiede VRAM libera
#    Se CUDA error dopo Llama: esegui 'ollama stop'
#
ACTIVE_LLM=gemini

# --- PARSER CONFIGURATION ---
# Active Parser: antlr4_custom | antlr3_official
#
# antlr4_custom:   Parser convertito (100% testato)
# antlr3_official: Parser ufficiale prof (WIP)
#
ACTIVE_PARSER=antlr3_official