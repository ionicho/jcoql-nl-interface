# ============================================
# J-CO-QL+ NL Interface - Environment Variables
# ============================================

# --- GOOGLE GEMINI API ---
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# --- LLM CONFIGURATION ---
# Active LLM: gemini | llama | gemma | llama32 | gemma4
#
# gemini:  Cloud (Gemini Flash Lite), limited by the free-tier quota
# llama:   Local, no quota (Llama 3.1 8B - 4.7GB VRAM)
# gemma:   Local, no quota (Gemma 1 7B - 5.4GB VRAM)
# llama32: Local, no quota (Llama 3.2 3B - 2GB VRAM)
# gemma4:  Local, no quota (Gemma 4 E4B - 6.6GB VRAM)
#
# VRAM NOTE: local models need free VRAM.
#    If you get a CUDA error after another local model: run 'ollama ps',
#    then 'ollama stop <model-name>'
#
ACTIVE_LLM=gemini

# --- PROMPT MODE FOR LOCAL MODELS ---
# compact (default) | full | tuned
# Can also be changed at runtime (the interface does it with the Mode selector):
# POST /api/set_local_prompt_mode?mode=compact|full|tuned
#
# tuned: short prompt for the fine-tuned Llama 3.1 (base model + LoRA adapter), served by llama-server.
#        Start the server first: finetune\soup\start_llama_server_v4.ps1 (port 8081, wait for 'listening').
#        Only Llama 3.1 is available in this mode.
#
# LOCAL_PROMPT_MODE=compact
#
# URL of llama-server, only needed if it is not on the default http://127.0.0.1:8081
# LLAMACPP_URL=http://127.0.0.1:8081

# --- PARSER CONFIGURATION ---
# Active Parser: antlr4_custom | antlr3_official
#
# antlr4_custom:   Converted parser
# antlr3_official: Official parser of the J-CO project (the one used and tested)
#
ACTIVE_PARSER=antlr3_official
