ESEMPIO 1: TOP N Base
Descrizione: Seleziona i primi 10 hotel più costosi
Query:
GET COLLECTION hotels;
SORT BY .price DESC;
TOP 10;

ESEMPIO 2: TOP con Filtro
Descrizione: Primi 5 prodotti elettronici più venduti
Query:
GET COLLECTION products;
FILTER CASE WHERE .category = 'electronics';
SORT BY .sales DESC;
TOP 5;

ESEMPIO 3: TOP Crescente
Descrizione: I 3 hotel più economici a Milano
Query:
GET COLLECTION hotels;
FILTER CASE WHERE .city = 'Milano';
SORT BY .price ASC;
TOP 3;

ESEMPIO 4: GROUP BY con COUNT
Descrizione: Conta il numero di clienti per città
Query:
GET COLLECTION customers;
GROUP BY .city WITH COUNT;

ESEMPIO 5: GROUP BY con SUM
Descrizione: Totale vendite per categoria prodotto
Query:
GET COLLECTION orders;
GROUP BY .category WITH SUM(.amount);

ESEMPIO 6: GROUP BY con AVG
Descrizione: Calcola il prezzo medio per categoria
Query:
GET COLLECTION products;
GROUP BY .category WITH AVG(.price) AS .average_price;

ESEMPIO 7: GROUP BY con Multiple Aggregazioni
Descrizione: Per ogni città conta utenti e calcola età media
Query:
GET COLLECTION users;
GROUP BY .city WITH COUNT AS .total_users, AVG(.age) AS .average_age;

ESEMPIO 8: GROUP BY con MIN/MAX
Descrizione: Prezzo minimo e massimo per categoria
Query:
GET COLLECTION products;
GROUP BY .category WITH MIN(.price) AS .min_price, MAX(.price) AS .max_price;

ESEMPIO 9: SORT BY Multiplo
Descrizione: Ordina hotel per città (alfabetico) e poi per prezzo (decrescente)
Query:
GET COLLECTION hotels;
SORT BY .city ASC, .price DESC;

ESEMPIO 10: TOP dopo GROUP BY
Descrizione: Le 5 città con più clienti
Query:
GET COLLECTION customers;
GROUP BY .city WITH COUNT AS .total;
SORT BY .total DESC;
TOP 5;