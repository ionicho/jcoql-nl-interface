{
  "database": "jcoql_test",
  "description": "Database MongoDB per test interfaccia NL → JCoQL+",
  "collections": [
    {
      "name": "hotels",
      "description": "Hotel e strutture ricettive",
      "schema": {
        "_id": "string",
        "name": "string",
        "location": {
          "city": "string",
          "country": "string",
          "address": "string",
          "coordinates": {
            "lat": "number",
            "lng": "number"
          }
        },
        "rating": "number",
        "price_per_night": "number",
        "stars": "integer",
        "amenities": ["string"],
        "rooms": "integer",
        "available": "boolean",
        "parking": "boolean",
        "wifi": "boolean",
        "breakfast_included": "boolean"
      }
    },
    {
      "name": "products",
      "description": "Prodotti e-commerce",
      "schema": {
        "_id": "string",
        "name": "string",
        "category": "string",
        "price": "number",
        "stock": "integer",
        "brand": "string",
        "discount": "number",
        "rating": "number",
        "organic": "boolean",
        "description": "string",
        "reviews": ["object"]
      }
    },
    {
      "name": "users",
      "description": "Utenti registrati",
      "schema": {
        "_id": "string",
        "name": "string",
        "email": "string",
        "age": "integer",
        "city": "string",
        "country": "string",
        "premium": "boolean",
        "active": "boolean",
        "email_verified": "boolean",
        "phone": "string",
        "registration_date": "string",
        "orders": ["string"]
      }
    },
    {
      "name": "orders",
      "description": "Ordini e-commerce",
      "schema": {
        "_id": "string",
        "user_id": "string",
        "total": "number",
        "status": "string",
        "items": ["object"],
        "shipping_address": "string",
        "order_date": "string",
        "tracking_number": "string",
        "priority": "string"
      }
    },
    {
      "name": "restaurants",
      "description": "Ristoranti",
      "schema": {
        "_id": "string",
        "name": "string",
        "city": "string",
        "cuisine": "string",
        "rating": "number",
        "price_range": "string",
        "status": "string",
        "outdoor_seating": "boolean",
        "gluten_free_menu": "boolean"
      }
    }
  ]
}